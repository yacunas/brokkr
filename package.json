{
  "name": "brokkr",
  "version": "0.0.0",
  "private": true,
  "description": "Brokkr — reusable TypeScript libraries and adapters, forged for reuse across apps (@brokkr/*)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}

{
  "name": "@brokkr/serde-engine",
  "version": "0.1.0",
  "description": "Structured, extensible, versioned serialization for TypeScript — round-trips Date/Map/Set/BigInt/RegExp/URL, custom codecs, precise errors, injectable. Zero dependencies.",
  "license": "MIT",
  "author": "Yronnel James",
  "keywords": ["brokkr", "serde", "serialize", "deserialize", "json", "codec", "structured-clone", "bigint", "nestjs", "versioning"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yronneljames/brokkr.git",
    "directory": "packages/serde-engine"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "decimal.js": "^10.4.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

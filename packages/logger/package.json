{
  "name": "@brokkr/logger",
  "version": "0.1.0",
  "description": "Structured, typed, testable logging for TypeScript — ordered levels with a minimum-level filter, immutable child loggers with bindings, field redaction, Error serialization, and a pluggable sink. Zero dependencies.",
  "license": "MIT",
  "author": "Yronnel James",
  "keywords": [
    "brokkr",
    "logger",
    "logging",
    "structured-logging",
    "json-lines",
    "child-logger",
    "redaction",
    "sink"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yacunas/brokkr.git",
    "directory": "packages/logger"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

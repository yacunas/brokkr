{
  "name": "@brokkr/guard",
  "version": "0.1.0",
  "description": "Typed authorization for TypeScript — role-based (RBAC) and attribute-based (ABAC) access control with allow/deny rules, wildcards, ownership conditions, and a ForbiddenError assert. Framework-agnostic, zero dependencies.",
  "license": "MIT",
  "author": "Yronnel James",
  "keywords": [
    "brokkr",
    "guard",
    "authorization",
    "rbac",
    "abac",
    "access-control",
    "permissions",
    "policy"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yacunas/brokkr.git",
    "directory": "packages/guard"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

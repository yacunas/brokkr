{
  "name": "@brokkr/events",
  "version": "0.1.0",
  "description": "A strongly-typed event emitter / bus for TypeScript — fully typed event names and payloads, sync and async emit, error isolation, and unsubscribe handles. Zero dependencies.",
  "license": "MIT",
  "author": "Yronnel James",
  "keywords": [
    "brokkr",
    "events",
    "event-emitter",
    "event-bus",
    "typed",
    "pubsub",
    "emitter",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yacunas/brokkr.git",
    "directory": "packages/events"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@brokkr/result",
  "version": "0.1.0",
  "description": "A typed Result/Either type for error handling without exceptions — ok/err constructors, guards, pure combinators (map, mapErr, andThen, unwrap, match), and interop with throwables and promises. Zero dependencies.",
  "license": "MIT",
  "author": "Yronnel James",
  "keywords": [
    "brokkr",
    "result",
    "either",
    "error-handling",
    "functional",
    "monad",
    "type-safe",
    "railway"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yacunas/brokkr.git",
    "directory": "packages/result"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
